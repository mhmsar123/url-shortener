# ===== قاعدة البيانات =====
# محليًا (للتطوير بدون أي إعداد): استخدم SQLite
DATABASE_URL="file:./dev.db"
#
# للنشر على الإنتاج (Neon / Supabase / Render ...):
# نفّذ أولاً:  npm run db:use:postgres
# ثم ضع هنا رابط قاعدة بيانات PostgreSQL المجانية:
# DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DBNAME?sslmode=require"

# ===== الأمان / الجلسات =====
# أنشئ مفتاحًا عشوائيًا طويلًا، مثال:
# node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
AUTH_SECRET="change-me-to-a-long-random-string"

# ===== حساب الأدمن الافتراضي (يُنشأ عند تنفيذ db:seed) =====
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD="Admin123!"

# ===== رابط الموقع (يُستخدم في الروابط المختصرة) =====
# اتركه فارغًا ليُحتسب تلقائيًا من الدومين الحالي في كل طلب.
# عند ربط دومين مخصص ضع:  https://short.example.com
APP_BASE_URL=""

# ===== CAPTCHA اختياري (Cloudflare Turnstile - مجاني) =====
# اتركهما فارغين لإيقاف CAPTCHA، أو ضع مفاتيحك لتشغيله:
NEXT_PUBLIC_TURNSTILE_SITE_KEY=""
TURNSTILE_SECRET_KEY=""
